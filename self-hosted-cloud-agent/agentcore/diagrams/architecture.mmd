%% Simple component view. Render PNG: python3 diagrams/render_architecture.py
%% Cookbook github/ is a static template, not generated. Copy:
%%   github/cursor-agent-in-progress.yml -> <sample-repo>/.github/workflows/
%%   github/kick_cursor_agent.py         -> <sample-repo>/.github/scripts/kick_cursor_agent.py
%% kaushalavardhanam is the example sample repo used to demonstrate Cloud Agent capacity.
flowchart LR
  OP[Operator]
  GH[Sample repo]
  SM[Secrets Manager]
  ECR[Amazon ECR]
  RT[AgentCore Runtime]
  EC2[Managed instance]
  EBS[EBS /mnt/workspace]
  CA[Cursor Cloud Agents]
  GHA[GitHub Actions]

  subgraph CFG["Configure"]
    GH
  end
  subgraph CRED["Create and export credentials"]
    SM
    ECR
  end
  subgraph RUN["Run"]
    subgraph VPC["VPC egress only"]
      RT
      EC2
      EBS
    end
    CA
    GHA
  end

  OP -->|1 copy workflow + .github/scripts| GH
  OP -->|2 grant GitHub App| GH
  OP -.->|3 put-secret| SM
  OP -.->|4 push image| ECR
  OP -.->|5 gh secret set| GH
  OP -->|6 InvokeAgentRuntime| RT
  RT -->|7 start session| EC2
  ECR -->|8 pull image| EC2
  SM -->|9 GetSecretValue| EC2
  EBS -->|10 mount workspace| EC2
  EC2 -->|11 outbound HTTPS| CA
  GH -->|12 workflow| GHA
  GHA -->|13 POST /v1/agents| CA
  CA -->|14 GitHub App PR| GH
