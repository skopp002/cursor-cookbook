%% Operator env + 15-step path. Render: python3 diagrams/render_secrets_and_flow.py
%% Laptop Makefile: `-include .env` then `export`.
flowchart TB
  subgraph LAPTOP["1. Laptop — you export these"]
    E["cd self-hosted-cloud-agent/agentcore
cp .env.example .env
export CURSOR_API_KEY='key_...'
export WORKER_REPOSITORY_URL='https://github.com/kaushalavardhanam/kaushalavardhanam.git'
export AWS_REGION=us-west-2
export AWS_ACCOUNT_ID='...'
export CURSOR_WORKER_POOL_NAME=agentcore-platform-agents
export GH_PROJECT_TOKEN='github_pat_...'
export AGENTCORE_SESSION_ID='cursor-worker-&lt;uuid&gt;'"]
  end

  subgraph GHUB["2. GitHub Actions — sample app repo"]
    S["gh secret set CURSOR_API_KEY --body \"$CURSOR_API_KEY\"
gh secret set GH_PROJECT_TOKEN --body \"$GH_PROJECT_TOKEN\"
env:
  CURSOR_API_KEY: ${{ secrets.CURSOR_API_KEY }}
  GH_PROJECT_TOKEN: ${{ secrets.GH_PROJECT_TOKEN }}"]
  end

  subgraph AWS["3. AgentCore runtime — Terraform, not the raw key"]
    R["CURSOR_API_KEY_SECRET_ID=&lt;secret ARN&gt;
WORKER_REPOSITORY_URL=&lt;app git URL&gt;
CURSOR_WORKER_POOL_NAME=agentcore-platform-agents
CURSOR_WORKER_DIR=/mnt/workspace"]
  end

  subgraph WORKER["4. Worker child — adapter injects the key"]
    W["aws secretsmanager get-secret-value --secret-id \"$CURSOR_API_KEY_SECRET_ID\"
export CURSOR_API_KEY='&lt;fetched value&gt;'
agent worker --pool start"]
  end

  E -->|make agentcore-put-api-key-secret| R
  E -->|gh secret set| S
  R -->|GetSecretValue| W
  S -->|POST /v1/agents| W
