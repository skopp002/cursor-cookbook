%% Sequence of who holds which secret, and how kickoff runs.
%% Render PNG: python3 diagrams/render_secrets_and_flow.py
%% Short codes: ENV laptop .env · CB cookbook · SEC Actions secrets · GH sample repo
%%              CA Cloud Agents API · SM Secrets Manager · ECR image · AC worker
sequenceDiagram
  autonumber
  box Operator
    participant ENV as ENV
    participant CB as CB
  end
  box GitHub
    participant SEC as SEC
    participant GH as GH
  end
  box Cursor
    participant CA as CA
  end
  box AWS
    participant SM as SM
    participant ECR as ECR
    participant AC as AC
  end

  Note over ENV,AC: Setup (dashed in the PNG)
  CB-->>GH: 1 Copy templates
  CB-->>CA: 2 Grant GitHub App
  CB-->>AC: 3 Create AWS infra
  CB-->>ECR: 4 Push worker image
  ENV-->>SM: 5 Put API key secret
  ENV-->>SEC: 6 Store Actions secrets
  SEC-->>GH: 7 Inject workflow secrets
  ENV-->>AC: 8 Start session
  ECR-->>AC: 8 Pull image

  Note over SM,AC: Boot
  SM-->>AC: 9 Fetch API key
  AC-->>AC: 10 Set git origin

  Note over GH,AC: Run (solid in the PNG)
  AC->>CA: 11 Register outbound
  GH->>CA: 12 Kick off agent
  CA->>AC: 13 Assign job
  AC->>AC: 14 Edit workspace
  CA->>GH: 15 Open PR
